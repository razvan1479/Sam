# Copiază acest fișier ca „.env" și completează valorile.

# --- Bot ---
# Tokenul botului (Discord Developer Portal → aplicația ta → Bot → Reset Token)
SAM_TOKEN=pune_tokenul_aici

# ID-ul serverului tău (opțional, dar recomandat pentru test — comenzile apar instant).
# Discord → Settings → Advanced → Developer Mode ON → click-dreapta pe server → Copy Server ID.
GUILD_ID=pune_id_ul_serverului_aici

# --- Dashboard web ---
# Portul pe care rulează dashboard-ul (pune-l diferit de Sir Penguin).
DASHBOARD_PORT=5001
